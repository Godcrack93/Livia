# Pipoca Aprende — chave de upload do Google Play. Este arquivo NÃO vai para o git.
# Copie para "keystore.properties" (na mesma pasta), preencha e rode: gradlew.bat bundleRelease
# Crie a chave uma vez só e guarde uma cópia em lugar seguro (sem ela não dá para enviar atualizações).
# Exemplo para criar a chave (no terminal, dentro desta pasta):
#   keytool -genkeypair -v -keystore chave-upload-pipoca.jks -alias upload -keyalg RSA -keysize 4096 -validity 10000

# Caminho do arquivo .jks (relativo a esta pasta "aplicativo" ou absoluto, com barras /).
storeFile=chave-upload-pipoca.jks
storePassword=
keyAlias=upload
keyPassword=
